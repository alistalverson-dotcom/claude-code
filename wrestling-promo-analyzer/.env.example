# ============================================================================
# WRESTLING PROMO ANALYZER - ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# ============================================================================

# ============================================================================
# CRITICAL - MUST SET BEFORE RUNNING
# ============================================================================

# Anthropic API Key (REQUIRED)
# Get your key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-your-key-here

# PostgreSQL Password (REQUIRED)
# Change this to a secure password
POSTGRES_PASSWORD=your_secure_password_here

# Secret Key (REQUIRED for production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here

# ============================================================================
# APPLICATION SETTINGS
# ============================================================================

# Environment (development, staging, production)
APP_ENV=development

# Debug mode (true for development, false for production)
DEBUG=true

# ============================================================================
# DATABASE SETTINGS
# ============================================================================

# PostgreSQL connection (auto-constructed from above)
# DATABASE_URL=postgresql://promo_admin:${POSTGRES_PASSWORD}@postgres:5432/promo_analyzer
POSTGRES_USER=promo_admin
POSTGRES_DB=promo_analyzer

# ============================================================================
# REDIS & CELERY
# ============================================================================

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ============================================================================
# FILE UPLOAD SETTINGS
# ============================================================================

# Upload directory (inside container)
UPLOAD_DIR=/app/uploads

# Maximum upload size in MB
MAX_UPLOAD_SIZE_MB=500

# Allowed video formats (comma-separated)
ALLOWED_VIDEO_FORMATS=mp4,mov,avi,mkv

# ============================================================================
# VIDEO PROCESSING
# ============================================================================

# FFmpeg path (ffmpeg is pre-installed in container)
FFMPEG_PATH=ffmpeg

# Whisper model (tiny, base, small, medium, large)
# base = good balance of speed and accuracy
WHISPER_MODEL=base

# Whisper device (cpu or cuda)
WHISPER_DEVICE=cpu

# ============================================================================
# AI SETTINGS (Claude API)
# ============================================================================

# Claude model to use
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Maximum tokens in response
ANTHROPIC_MAX_TOKENS=4000

# Temperature (0.0-1.0, higher = more creative)
ANTHROPIC_TEMPERATURE=0.7

# ============================================================================
# CORS SETTINGS
# ============================================================================

# Allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# FRONTEND SETTINGS
# ============================================================================

# API URL for frontend
VITE_API_URL=http://localhost:8000

# ============================================================================
# OPTIONAL SETTINGS
# ============================================================================

# Celery worker concurrency
CELERY_WORKER_CONCURRENCY=2

# Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
